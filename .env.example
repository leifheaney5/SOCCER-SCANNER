# Local runtime. Never commit real credentials.
APP_ENVIRONMENT=development
APP_VERSION=2.0.0
GIT_COMMIT_SHA=
BUILD_TIMESTAMP=
PUBLIC_BASE_URL=http://127.0.0.1:5000
TRUSTED_PROXY_HOPS=0
PORT=5000
WEB_CONCURRENCY=2
RAILPACK_PYTHON_VERSION=3.13.14

# Optional provider capability. ESPN fixtures do not require a key.
FOOTBALL_DATA_API_KEY=

# Optional locally. PostgreSQL and shared Redis are required for readiness in production.
DATABASE_URL=
REDIS_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=5
DATABASE_POOL_RECYCLE=300

# Required to access protected operations endpoints. Generate a high-entropy secret.
OPS_ADMIN_TOKEN=
