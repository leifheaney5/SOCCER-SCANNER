# Local runtime. Never commit real credentials.
APP_ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:5000
TRUSTED_PROXY_HOPS=0
PORT=5000
WEB_CONCURRENCY=2

# Optional provider capability. ESPN fixtures do not require a key.
FOOTBALL_DATA_API_KEY=

# Optional locally; recommended in production for cross-worker coordination.
REDIS_URL=
