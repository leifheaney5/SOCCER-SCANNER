# Production Environment Variables
# Copy these to your deployment platform's environment variable settings

# Required: Football Data API Key
# Get your free key from: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_api_key_here

# Flask Environment (production for live deployments)
FLASK_ENV=production

# Flask Debug (must be False in production)
FLASK_DEBUG=False

# Port (usually auto-set by deployment platform, defaults to 5000)
# PORT=5000
